# MySQL database and application login
DB_NAME=resource_tracker
DB_USER=resource_tracker_user
DB_PASSWORD=replace-with-a-strong-database-password

# Host ports (container ports remain 3306 for MySQL and 8080 for the backend)
DB_HOST_PORT=3307
PORT=8080

# Generate a unique secret with: openssl rand -base64 48
APP_SECURITY_JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Optional SMTP configuration for application email
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_MAIL_FROM=no-reply@resource-tracker.local
APP_FRONTEND_BASE_URL=http://localhost:3000
