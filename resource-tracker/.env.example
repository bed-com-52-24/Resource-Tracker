# MySQL database and application login
DB_NAME=resource_tracker
DB_USER=resource_tracker_user
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_HOST=127.0.0.1
# For a local Compose MySQL connection, set DB_PORT to DB_HOST_PORT below.
DB_PORT=3306

# Host ports (container ports remain 3306 for MySQL and 8080 for the backend)
DB_HOST_PORT=3307
PORT=8080

# Generate a unique secret with: openssl rand -base64 48
APP_SECURITY_JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Production URL used by Docker
DATABASE_URL="jdbc:mysql://mysql:3306/resource_tracker?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"

# Datasource credentials
DATASOURCE_USERNAME=root
DATASOURCE_PASSWORD=replace-with-a-strong-datasource-password
SPRING_DATASOURCE_USERNAME=resource_tracker_user
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-database-password
SPRING_DATASOURCE_URL="jdbc:mysql://127.0.0.1:3306/resource_tracker?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"

# Optional SMTP configuration for application email
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_MAIL_FROM=no-reply@resource-tracker.local
APP_FRONTEND_BASE_URL=http://localhost:3000
